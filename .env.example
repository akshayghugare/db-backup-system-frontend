# Copy this file to .env and adjust if needed.
# Values starting with VITE_ are built into the page, so never put secrets here.

# Base URL of the backend API (without /api at the end).
# Leave empty to call the API on the same address the page is served from
# (the Vite dev proxy, or the backend serving frontend/dist).
VITE_API_BASE_URL=http://localhost:4800

# Port of the Vite dev server. If you change it, add the new address to
# FRONTEND_ORIGIN in backend/.env (e.g. http://localhost:5175).
VITE_DEV_PORT=5175
